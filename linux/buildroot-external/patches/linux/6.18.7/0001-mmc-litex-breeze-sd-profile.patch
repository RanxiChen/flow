From: Flow contributors <flow@localhost>
Subject: [PATCH] mmc: litex: support Breeze SD PHY and coherent DMA profile

Target the SD CSR ABI generated by KCU105 revision 29ee514.
Use native 1/4-bit switching, bounded completion waits and aligned bounce DMA.
The legacy litex,mmc path retains its four-bit command injection.

--- a/drivers/mmc/host/litex_mmc.c
+++ b/drivers/mmc/host/litex_mmc.c
@@ -19,6 +19,7 @@
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/of.h>
 
 #include <linux/mmc/host.h>
 #include <linux/mmc/mmc.h>
@@ -28,6 +29,10 @@
 #define LITEX_PHY_CLOCKERDIV  0x04
 #define LITEX_PHY_INITIALIZE  0x08
 #define LITEX_PHY_WRITESTATUS 0x0C
+/* Flow SD PHY revision: programmable 1/4-bit bus width. */
+#define FLOW_PHY_SETTINGS    0x18
+#define FLOW_DMA_ERROR       0x1C
+#define FLOW_IRQ_CMD_DONE    BIT(4)
 #define LITEX_CORE_CMDARG     0x00
 #define LITEX_CORE_CMDCMD     0x04
 #define LITEX_CORE_CMDSND     0x08
@@ -95,6 +100,9 @@
 	u32 resp[4];
 	u16 rca;
 
+	bool flow_sd;
+	u32 cmd_irq;
+	bool powered;
 	bool is_bus_width_set;
 	bool app_cmd;
 };
@@ -105,7 +113,7 @@
 	int ret;
 
 	ret = readx_poll_timeout(litex_read8, reg, evt, evt & SD_BIT_DONE,
-				 SD_SLEEP_US, SD_TIMEOUT_US);
+				 SD_SLEEP_US, 1000000);
 	if (ret)
 		return ret;
 	if (evt == SD_BIT_DONE)
@@ -128,6 +136,11 @@
 	int ret;
 	u8 evt;
 
+	if (host->flow_sd && host->irq > 0) {
+		litex_write32(host->sdirq + LITEX_IRQ_ENABLE, SDIRQ_CARD_DETECT);
+		reinit_completion(&host->cmd_done);
+	}
+
 	litex_write32(host->sdcore + LITEX_CORE_CMDARG, arg);
 	litex_write32(host->sdcore + LITEX_CORE_CMDCMD,
 		      cmd << 8 | transfer << 5 | response_len);
@@ -140,10 +153,16 @@
 	if (host->irq > 0 &&
 	    (transfer != SD_CTL_DATA_XFER_NONE ||
 	     response_len == SD_CTL_RESP_SHORT_BUSY)) {
-		reinit_completion(&host->cmd_done);
+		if (!host->flow_sd)
+			reinit_completion(&host->cmd_done);
 		litex_write32(host->sdirq + LITEX_IRQ_ENABLE,
-			      SDIRQ_CMD_DONE | SDIRQ_CARD_DETECT);
-		wait_for_completion(&host->cmd_done);
+			      host->cmd_irq | SDIRQ_CARD_DETECT);
+		if (!wait_for_completion_timeout(&host->cmd_done,
+					 msecs_to_jiffies(1000))) {
+			litex_write32(host->sdirq + LITEX_IRQ_ENABLE,
+				      SDIRQ_CARD_DETECT);
+			return -ETIMEDOUT;
+		}
 	}
 
 	ret = litex_mmc_sdcard_wait_done(host->sdcore + LITEX_CORE_CMDEVT, dev);
@@ -180,7 +199,7 @@
 		host->sdreader + LITEX_BLK2MEM_DONE :
 		host->sdwriter + LITEX_MEM2BLK_DONE;
 	ret = readx_poll_timeout(litex_read8, reg, evt, evt & SD_BIT_DONE,
-				 SD_SLEEP_US, SD_TIMEOUT_US);
+				 SD_SLEEP_US, 1000000);
 	if (ret)
 		dev_err(dev, "DMA timeout (cmd %d)\n", cmd);
 
@@ -266,7 +285,7 @@
 	}
 
 	/* Check for command completed */
-	if (pending & SDIRQ_CMD_DONE) {
+	if (pending & host->cmd_irq) {
 		/* Disable it so it doesn't keep interrupting */
 		litex_write32(host->sdirq + LITEX_IRQ_ENABLE,
 			      SDIRQ_CARD_DETECT);
@@ -302,8 +321,11 @@
 	 */
 	dma = host->dma;
 	*len = data->blksz * data->blocks;
-	sg_count = dma_map_sg(dev, data->sg, data->sg_len,
-			      mmc_get_dma_dir(data));
+	/* Flow uses an aligned coherent bounce buffer for all requests.
+	 * This also covers short SCR/status transfers and unaligned SG data.
+	 */
+	sg_count = host->flow_sd ? 0 :
+		dma_map_sg(dev, data->sg, data->sg_len, mmc_get_dma_dir(data));
 	if (sg_count == 1) {
 		dma = sg_dma_address(data->sg);
 		*len = sg_dma_len(data->sg);
@@ -368,7 +390,7 @@
 		}
 	}
 
-	if (data) {
+	if (data && !host->flow_sd) {
 		/*
 		 * LiteSDCard only supports 4-bit bus width; therefore, we MUST
 		 * inject a SET_BUS_WIDTH (acmd6) before the very first data
@@ -382,13 +404,15 @@
 			return;
 		}
 
+	}
+
+	if (data)
 		litex_mmc_do_dma(host, data, &len, &direct, &transfer);
-	}
 
 	do {
 		cmd->error = litex_mmc_send_cmd(host, cmd->opcode, cmd->arg,
 						response_len, transfer);
-	} while (cmd->error && retries-- > 0);
+	} while (cmd->error && !host->flow_sd && retries-- > 0);
 
 	if (cmd->error) {
 		/* Card may be gone; don't assume bus width is still set */
@@ -415,7 +439,18 @@
 			host->is_bus_width_set = false;
 	}
 
-	if (data) {
+	if (data && host->flow_sd) {
+		void __iomem *dma_regs = (data->flags & MMC_DATA_READ) ?
+			host->sdreader : host->sdwriter;
+
+		if (litex_read32(dma_regs + FLOW_DMA_ERROR) && !cmd->error)
+			cmd->error = -EIO;
+		litex_write8(dma_regs + LITEX_BLK2MEM_ENA, 0);
+		if (cmd->error)
+			data->error = cmd->error;
+	}
+
+	if (data && !host->flow_sd) {
 		dma_unmap_sg(dev, data->sg, data->sg_len,
 			     mmc_get_dma_dir(data));
 	}
@@ -436,7 +471,7 @@
 	struct device *dev = mmc_dev(host->mmc);
 	u32 div;
 
-	div = freq ? host->ref_clk / freq : 256U;
+	div = freq ? DIV_ROUND_UP(host->ref_clk, freq) : 256U;
 	div = roundup_pow_of_two(div);
 	div = clamp(div, 2U, 256U);
 	dev_dbg(dev, "sd_clk_freq=%d: set to %d via div=%d\n",
@@ -455,6 +490,22 @@
 	 * which is redundant since we snoop on the command flow and inject
 	 * an early acmd6 before the first data transfer command is sent!
 	 */
+
+	if (host->flow_sd) {
+		if (ios->power_mode == MMC_POWER_OFF) {
+			host->powered = false;
+			litex_write8(host->sdphy + FLOW_PHY_SETTINGS, 0);
+		}
+		if (ios->power_mode == MMC_POWER_UP && !host->powered) {
+			litex_write8(host->sdphy + FLOW_PHY_SETTINGS, 0);
+			litex_mmc_setclk(host, 400000);
+			litex_write8(host->sdphy + LITEX_PHY_INITIALIZE, 1);
+			usleep_range(1000, 2000); /* 80 initial clocks */
+			host->powered = true;
+		}
+		litex_write8(host->sdphy + FLOW_PHY_SETTINGS,
+			     ios->bus_width == MMC_BUS_WIDTH_4 ? 1 : 0);
+	}
 
 	/* Update sd_clk */
 	if (ios->clock != host->sd_clk)
@@ -526,6 +577,8 @@
 
 	host = mmc_priv(mmc);
 	host->mmc = mmc;
+	host->flow_sd = of_device_is_compatible(dev->of_node, "flow,breeze-litex-mmc-v1");
+	host->cmd_irq = host->flow_sd ? FLOW_IRQ_CMD_DONE : SDIRQ_CMD_DONE;
 
 	/* Initialize clock source */
 	clk = devm_clk_get(dev, NULL);
@@ -543,7 +596,7 @@
 	host->app_cmd = false;
 
 	/* LiteSDCard can support 64-bit DMA addressing */
-	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(64));
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(host->flow_sd ? 32 : 64));
 	if (ret)
 		return ret;
 
@@ -590,8 +643,8 @@
 	 * Set default sd_clk frequency range based on empirical observations
 	 * of LiteSDCard gateware behavior on typical SDCard media
 	 */
-	mmc->f_min = 12.5e6;
-	mmc->f_max = 50e6;
+	mmc->f_min = host->flow_sd ? DIV_ROUND_UP(host->ref_clk, 256) : 12500000;
+	mmc->f_max = host->flow_sd ? 5000000 : 50000000;
 
 	ret = mmc_of_parse(mmc);
 	if (ret)
@@ -628,6 +681,7 @@
 
 static const struct of_device_id litex_match[] = {
 	{ .compatible = "litex,mmc" },
+	{ .compatible = "flow,breeze-litex-mmc-v1" },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, litex_match);
--- a/Documentation/devicetree/bindings/mmc/litex,mmc.yaml
+++ b/Documentation/devicetree/bindings/mmc/litex,mmc.yaml
@@ -21,7 +21,9 @@
 
 properties:
   compatible:
-    const: litex,mmc
+    enum:
+      - litex,mmc
+      - flow,breeze-litex-mmc-v1
 
   reg:
     items:
@@ -50,6 +52,15 @@
     description:
       Handle to fixed-voltage supply for the card power.
 
+  dma-coherent: true
+
+  bus-width:
+    const: 4
+
+  max-frequency: true
+
+  non-removable: true
+
   interrupts:
     maxItems: 1
 
