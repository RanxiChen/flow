/include/ "flow-kcu105-tiny.dts"

/ {
    pmu {
        compatible = "riscv,pmu";
        /* Fixed counters: cycle=0, instret=2. */
        riscv,event-to-mhpmcounters = <0x1 0x1 0x1>, <0x2 0x2 0x4>;
        /* Breeze raw selectors 1..10; programmable counters 3..10. */
        riscv,raw-event-to-mhpmcounters =
            <0x0 0x1 0xffffffff 0xffffffff 0x7f8>,
            <0x0 0x2 0xffffffff 0xffffffff 0x7f8>,
            <0x0 0x3 0xffffffff 0xffffffff 0x7f8>,
            <0x0 0x4 0xffffffff 0xffffffff 0x7f8>,
            <0x0 0x5 0xffffffff 0xffffffff 0x7f8>,
            <0x0 0x6 0xffffffff 0xffffffff 0x7f8>,
            <0x0 0x7 0xffffffff 0xffffffff 0x7f8>,
            <0x0 0x8 0xffffffff 0xffffffff 0x7f8>,
            <0x0 0x9 0xffffffff 0xffffffff 0x7f8>,
            <0x0 0xa 0xffffffff 0xffffffff 0x7f8>;
    };
};
