# SD hosts and root filesystem must be available before mounting root.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_LITEX=y
CONFIG_EXT4_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# CONFIG_INITRAMFS_FORCE is not set
