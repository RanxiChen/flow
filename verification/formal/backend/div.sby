[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 80
prove: mode prove
prove: depth 80
cover: mode cover
cover: depth 80
timeout 1800

[engines]
smtbmc z3

[script]
read_verilog -formal -sv FormalInitialReset.sv DivProtocolFormal.sv
prep -top DivProtocolFormal

[files]
generated/div/FormalInitialReset.sv
generated/div/DivProtocolFormal.sv
