[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 80
prove: mode prove
prove: depth 80
cover: mode cover
cover: depth 80
timeout 1800

[engines]
smtbmc z3

[script]
read_verilog -formal -sv FormalInitialReset.sv FormalMulProbe.sv MulProtocolFormal.sv
prep -top MulProtocolFormal
# Overapproximate ONLY the combinational 65x65 product by arbitrary 130 bits
# each cycle. Keep every register, control signal and production property.
# Every concrete multiplier trace remains a trace of this stronger model.
select -assert-count 1 t:$mul
cutpoint t:$mul
select -clear

[files]
yosys/mul/FormalInitialReset.sv
yosys/mul/FormalMulProbe.sv
yosys/mul/MulProtocolFormal.sv
