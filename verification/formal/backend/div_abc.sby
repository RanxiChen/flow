[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 80
prove: mode prove
cover: mode cover
cover: depth 80
timeout 3600

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc z3

[script]
read_verilog -formal -sv FormalInitialReset.sv UnsignedRadix4DividerAbstract.sv FormalDivProbe.sv DivProtocolFormal.sv
prep -top DivProtocolFormal

[files]
yosys/div/FormalInitialReset.sv
UnsignedRadix4DividerAbstract.sv
yosys/div/FormalDivProbe.sv
yosys/div/DivProtocolFormal.sv
