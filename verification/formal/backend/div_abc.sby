[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 80
prove: mode prove
prove: depth 80
cover: mode cover
cover: depth 80
timeout 1800

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc z3

[script]
read_verilog -formal -sv FormalInitialReset.sv UnsignedRadix4Divider.sv FormalDivProbe.sv DivProtocolFormal.sv
prep -top DivProtocolFormal

[files]
yosys/div/FormalInitialReset.sv
yosys/div/UnsignedRadix4Divider.sv
yosys/div/FormalDivProbe.sv
yosys/div/DivProtocolFormal.sv
