        <mxCell id="f0" value="" style="rounded=0;html=1;container=1;pointerEvents=0;fillColor=#edf4ff;strokeColor=#5178b3;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="170" width="350" height="355" />
        </mxCell>
        <mxCell id="f0-heading" value="F0｜第 1 拍：并行查询" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontColor=#243247;fontSize=22;fontStyle=1;" vertex="1" parent="f0">
          <mxGeometry as="geometry" x="18" y="14" width="318" height="36" />
        </mxCell>
        <mxCell id="f0-body" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;取指&lt;br&gt;ICache Tag/Data 索引读取&lt;br&gt;iTLB 查询&lt;br&gt;&amp;nbsp;&lt;br&gt;预测：PC、PC+2 两个位置&lt;br&gt;访问两个 BTB bank&lt;br&gt;启动 GShare 查询&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontColor=#243247;fontSize=18;verticalAlign=top;" vertex="1" parent="f0">
          <mxGeometry as="geometry" x="20" y="66" width="310" height="275" />
        </mxCell>
        <mxCell id="f1" value="" style="rounded=0;html=1;container=1;pointerEvents=0;fillColor=#eef8f2;strokeColor=#4b8967;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="485" y="170" width="350" height="355" />
        </mxCell>
        <mxCell id="f1-heading" value="F1｜第 2 拍：结果与选择" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontColor=#243247;fontSize=22;fontStyle=1;" vertex="1" parent="f1">
          <mxGeometry as="geometry" x="18" y="14" width="318" height="36" />
        </mxCell>
        <mxCell id="f1-body" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;取指&lt;br&gt;接收 iTLB 与 ICache 结果&lt;br&gt;PA tag / 页权限检查、命中选路&lt;br&gt;得到 32 位取指数据&lt;br&gt;&amp;nbsp;&lt;br&gt;预测&lt;br&gt;BTB 命中与 GShare 方向结果&lt;br&gt;按程序顺序选择控制流目标&lt;br&gt;形成预测 NPC&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontColor=#243247;fontSize=18;verticalAlign=top;" vertex="1" parent="f1">
          <mxGeometry as="geometry" x="20" y="66" width="310" height="275" />
        </mxCell>
        <mxCell id="f2" value="" style="rounded=0;html=1;container=1;pointerEvents=0;fillColor=#fff5e9;strokeColor=#b18146;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="900" y="170" width="350" height="355" />
        </mxCell>
        <mxCell id="f2-heading" value="F2｜第 3 拍：重组与校正" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontColor=#243247;fontSize=22;fontStyle=1;" vertex="1" parent="f2">
          <mxGeometry as="geometry" x="18" y="14" width="318" height="36" />
        </mxCell>
        <mxCell id="f2-body" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;指令处理&lt;br&gt;确认 16 / 32 位指令边界&lt;br&gt;跨字拼接、RVC 展开&lt;br&gt;生成 0–2 条完整指令&lt;br&gt;&amp;nbsp;&lt;br&gt;预测校正&lt;br&gt;校验分支信息，识别 call / ret&lt;br&gt;RAS 返回预测及维护&lt;br&gt;必要时校正 NPC、冲刷年轻请求&lt;br&gt;拍末送入指令缓冲&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontColor=#243247;fontSize=18;verticalAlign=top;" vertex="1" parent="f2">
          <mxGeometry as="geometry" x="20" y="66" width="310" height="275" />
        </mxCell>
        <mxCell id="e01" edge="1" parent="1" source="f0" target="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#566579;strokeWidth=2;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="f1" target="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#566579;strokeWidth=2;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="pending" value="待定：取指窗口对齐｜组内 GHR 查询与更新｜F1 → F0 的反馈边界" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontColor=#243247;fontSize=18;fontColor=#9a651c;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="585" width="1180" height="32" />
