        <mxCell id="note" value="同一请求依次经过 F0 → F1 → F2；不同请求可以同时占据这三个级。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontColor=#243247;fontSize=17;fontColor=#64748b;" vertex="1" parent="1">
