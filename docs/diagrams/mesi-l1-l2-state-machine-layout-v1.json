  "typography": {
    "font_family": "Noto Sans CJK SC or system sans-serif with Chinese support",
    "state_name": "bold 13-14px; implementation identifiers kept English verbatim",
    "body": "11-12px Chinese explanatory text; line height sufficient for wrapped labels",
    "edge_labels": "10-11px; concise but preserve authoritative labels exactly where given",
    "notes": "11px; loose-end keyword may be bold or emphasized; avoid tiny text",
    "accessibility": "minimum readable font 10px; avoid relying on color alone for loose ends or branch meaning"
  },
  "color_roles": {
    "state_fill": "light blue for normal FSM states",
    "state_stroke": "medium blue border",
    "initial_fill": "black filled circle",
    "branch_state_fill": "light amber or slightly stronger blue for fanout states such as S_COMPARE/S_EVICT/S_INV_CHECK",
    "message_fill": "light green for protocol message cards",
    "metadata_fill": "light purple or gray for directory metadata cards",
    "note_fill": "pale yellow for design constraints",
    "loose_end_fill": "pale red/orange with dashed border",
    "edge_normal": "dark gray solid directed arrows",
    "edge_loose_end": "dark orange dashed directed callout arrows",
    "page_region_fill": "very light neutral backgrounds with visible labels"
  },
  "domain_rules": {},
  "must_do": [
    {
      "id": "md_three_pages",
      "text": "Create exactly three Draw.io pages with names: L1 CPU Request FSM, L1 L2-Initiated Paths, L2 Coherence Overview."
    },
    {
      "id": "md_enumerate_page1",
      "text": "Page 1 must include all listed L1 CPU request states plus init, and every Page 1 transition edge listed in this contract."
    },
    {
      "id": "md_enumerate_page2",
      "text": "Page 2 must include one shared p2_st_idle for both Invalidate and GetData branches, all listed Invalidate states, gd_lookup/gd_return, and every Page 2 transition/callout edge."
    },
    {
      "id": "md_page3_overview",
      "text": "Page 3 must show L2 controller, lookup+directory read, all directory metadata concepts, all listed messages, target actors, and loose-end notes as overview concepts, not as a full FSM."
    },
    {
      "id": "md_chinese_labels",
      "text": "Use Chinese for explanatory labels while preserving implementation identifiers exactly: S_IDLE, GetS, GetM, WriteL2, WriteBack, Invalidate, GetData, Ack, Data Resp, M/E/S/I."
    },
    {
      "id": "md_l1_constraints",
      "text": "Visibly annotate L1 DCache participates in MESI, I-Cache does not, blocking L1 miss behavior, Write-Allocate + Write-Back, synchronous SRAM timing, true hit definition, and silent E->M."
    },
    {
      "id": "md_l2_constraints",
      "text": "Visibly annotate inclusive shared LLC directory, Write-Allocate + Write-Back, Directory S direct response convention, Directory E/M owner GetData requirement, and WriteBack direct update/install rule."
    },
    {
      "id": "md_loose_ends",
      "text": "Show documented loose ends as dashed notes/callouts: Store Hit-S request state, GetData opcode split, L2 memory refill FSM, GetM Invalidate/Ack counting, and L2 full FSM not expanded."
    },
    {
      "id": "md_arrow_semantics",
      "text": "Use directed arrows for transitions/messages and keep each edge label attached to the correct edge."
    },
    {
      "id": "md_readability",
      "text": "Maintain clear spacing, aligned ranks, and readable multiline labels; route loopbacks around the outside of state clusters."
    }
  ],
  "must_not": [
    {
      "id": "mn_no_undocumented_states",
      "text": "Do not add undocumented protocol states such as extra request, refill, ack-count, or memory-refill states beyond the authoritative lists."
    },
    {
      "id": "mn_no_full_l2_fsm",
      "text": "Do not turn Page 3 into a full L2 FSM; it must remain a coherence overview with explicit loose-end notes."
    },
    {
      "id": "mn_no_electrical",
      "text": "Do not include domain_rules.electrical.nets, source_port, target_port, net_id, electrical symbols, or wire/net modeling."
    },
    {
      "id": "mn_no_label_translation_ids",
      "text": "Do not translate implementation identifiers or protocol message names into Chinese."
    },
    {
      "id": "mn_no_hide_loose_ends",
      "text": "Do not omit or normalize loose ends into ordinary completed states or transitions."
    },
    {
      "id": "mn_no_icache_mesi",
      "text": "Do not imply I-Cache participates in MESI."
    },
    {
      "id": "mn_no_l2_data_newest_e_m",
      "text": "Do not imply L2 Data SRAM is necessarily newest when directory state is E/M."
    },
    {
      "id": "mn_no_decorative_conductors",
      "text": "Do not model visible conductors or decorative filled rectangles as protocol edges; all relationships must be real directed edges between nodes."
    }
  ],
  "review_checklist": [
    {
      "id": "rc_page_count_names",
      "text": "Verify the native Draw.io artifact has exactly the three required page names."
    },
    {
      "id": "rc_page1_states_edges",
      "text": "On Page 1, verify every Page 1 node id/label exists and all 18 documented transitions are present with correct source, target, and label."
    },
    {
      "id": "rc_page2_states_edges",
      "text": "On Page 2, verify Invalidate and GetData share p2_st_idle, all 11 required Page 2 edges/callouts are present, and GetData miss is only a loose-end note."
    },
    {
      "id": "rc_page3_messages_metadata",
      "text": "On Page 3, verify all 7 messages and all 4 directory metadata concepts appear with the required trigger/carries/result or metadata meaning."
    },
    {
